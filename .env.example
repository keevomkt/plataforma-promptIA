# Banco de dados: Postgres no Supabase (botão "Connect" do projeto).
#
# DATABASE_URL muda conforme onde a plataforma roda:
# - NO VERCEL (produção): pooler de TRANSAÇÃO, porta 6543, com ?pgbouncer=true&connection_limit=1.
#   O pooler de sessão (5432) aceita só 15 clientes no plano gratuito e cada servidor do Vercel
#   segura as conexões abertas mesmo parado: em 02/10/2026 isso esgotou as 15 vagas e derrubou o site.
# - NESTE COMPUTADOR (um processo só): pooler de SESSÃO, porta 5432, ?connection_limit=3 — daqui,
#   cada consulta no 6543 custa ~5 idas e voltas (0,73 s × 0,15 s no 5432).
#
# DIRECT_URL: sempre o pooler de sessão (5432); só o Prisma usa, para criar/alterar tabelas.
# Se a senha tiver símbolos (@ # / ? % :), escreva-os codificados (ex.: @ vira %40).
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?connection_limit=3"
# No Vercel: DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Nenhuma chave de IA é necessária: a análise e a alteração do prompt são
# feitas pelo motor local em src/lib/engine. Ver README ("Camada opcional de IA").

# Opcional: habilita "Diagnosticar a partir de uma conversa" na aba Alterar
# prompt (cola/anexa uma conversa real + comportamento esperado, e a IA
# localiza a causa provável no prompt). Sem isso, a função fica oculta e o
# resto da plataforma funciona normalmente.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_DIAGNOSIS_MODEL="claude-opus-5"

# Chave que assina as sessões de login (64 caracteres aleatórios). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Opcional: senha única extra na frente do site (autenticação básica do navegador).
# APP_PASSWORD=""
