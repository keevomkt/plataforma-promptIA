# Banco de dados: Postgres no Supabase (botão "Connect" do projeto).
# DATABASE_URL: Transaction pooler (porta 6543). DIRECT_URL: Session pooler (porta 5432).
# Se a senha tiver símbolos (@ # / ? % :), escreva-os codificados (ex.: @ vira %40).
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Nenhuma chave de IA é necessária: a análise e a alteração do prompt são
# feitas pelo motor local em src/lib/engine. Ver README ("Camada opcional de IA").

# Opcional: habilita "Diagnosticar a partir de uma conversa" na aba Alterar
# prompt (cola/anexa uma conversa real + comportamento esperado, e a IA
# localiza a causa provável no prompt). Sem isso, a função fica oculta e o
# resto da plataforma funciona normalmente.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_DIAGNOSIS_MODEL="claude-opus-5"
